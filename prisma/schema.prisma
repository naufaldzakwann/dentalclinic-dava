// Skema Fase 2 — booking online + data operasional klinik.
// Provider sqlite untuk pengembangan lokal; saat pindah ke Supabase cukup ganti
// provider "postgresql" + DATABASE_URL, lalu `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  short       String
  description String
  priceFrom   Int? // harga mulai (rupiah), null = "konsultasi dulu"
  duration    Int       @default(30) // menit — dipakai untuk hitung slot
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Dentist {
  id       String          @id @default(cuid())
  name     String
  bio      String?
  bookings Booking[]
  hours    OperatingHour[]
}

model OperatingHour {
  id        Int      @id @default(autoincrement())
  dentistId String?
  dentist   Dentist? @relation(fields: [dentistId], references: [id])
  dayOfWeek Int // 0=Minggu .. 6=Sabtu
  openTime  String // "09:00"
  closeTime String // "17:00"
  breakFrom String? // "12:00"
  breakTo   String? // "13:00"

  @@unique([dentistId, dayOfWeek])
}

model BlockedDate {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique
  reason String?
}

model Booking {
  id        String   @id @default(cuid())
  code      String   @unique // DFA-260924-0001
  name      String
  phone     String
  email     String?
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  dentistId String?
  dentist   Dentist? @relation(fields: [dentistId], references: [id])
  date      DateTime // tengah malam lokal tanggal kunjungan
  slotTime  String // "10:30"
  // Kunci slot aktif: "{dentistId}|{YYYYMMDD}|{HH:MM}". Dibuat NULL saat dibatalkan
  // agar slot langsung bisa dibooking lagi — pengganti @@unique([dentistId, date, slotTime])
  // yang di SQLite juga menghitung baris cancelled.
  slotKey   String?  @unique
  status    String   @default("pending") // pending|confirmed|completed|cancelled|no_show
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
